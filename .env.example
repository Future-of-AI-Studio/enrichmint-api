# ─── Runtime ───────────────────────────────────────────────
# development | staging | production
ENVIRONMENT=development
PORT=4100
# Origin of the web app (CORS and PayPal return URLs).
WEB_ORIGIN=http://localhost:3100

# ─── Database ──────────────────────────────────────────────
# Local: `yarn db:up` starts Postgres from docker-compose.yml on port 5435.
DATABASE_URL=postgresql://enrichmint:enrichmint@localhost:5435/enrichmint
DIRECT_URL=

# ─── Swagger (/docs) ───────────────────────────────────────
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=

# ─── Auth ──────────────────────────────────────────────────
# Required, at least 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_TTL_SECONDS=604800
JWT_ISSUER=enrichmint-api
JWT_AUDIENCE=enrichmint-frontend
SIGNUP_ENABLED=true

# ─── Rate limiting ─────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
MODEL_RATE_LIMIT_PER_MINUTE=20
TRUST_PROXY_HOPS=1

# ─── Marketplace economics ─────────────────────────────────
# 1500 = 15% platform commission (planning assumption, not a validated price).
COMMISSION_BPS=1500
# 500 = 5% of each guide sale goes to field note authors, paid from the commission above.
ENRICHMENT_SHARE_BPS=500
MIN_PRICE_CENTS=500
MAX_PRICE_CENTS=50000
AI_QUESTIONS_PER_PURCHASE=10
AI_ACCESS_DAYS=30
# Hours earnings are held before payout (refund window). 0 for demos.
PAYOUT_HOLD_HOURS=0
REQUEST_PAY_WINDOW_H=24

# ─── PayPal (sandbox) ──────────────────────────────────────
# Create a REST app at developer.paypal.com (Sandbox). Never use live credentials here.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the app's webhook settings (needed to verify signatures).
PAYPAL_WEBHOOK_ID=
PAYPAL_TIMEOUT_MS=20000
RECONCILE_ENABLED=true

# ─── OpenAI ────────────────────────────────────────────────
# Optional at boot; AI features answer 503 ai_not_configured until set. Calls use store=false.
OPENAI_API_KEY=
OPENAI_MODEL_GENERATE=gpt-5
OPENAI_MODEL_FAST=gpt-5-mini
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=2
OPENAI_PRICE_GENERATE_INPUT_PER_MTOK=1.25
OPENAI_PRICE_GENERATE_OUTPUT_PER_MTOK=10
OPENAI_PRICE_FAST_INPUT_PER_MTOK=0.25
OPENAI_PRICE_FAST_OUTPUT_PER_MTOK=2
AI_DAILY_BUDGET_USD=10

# ─── HCAI (optional; local policy rules always run) ────────
HCAI_ENABLED=false
HCAI_BASE_URL=
HCAI_API_KEY=
HCAI_TIMEOUT_MS=3000

# ─── Zapier (optional) ─────────────────────────────────────
# A Zapier "Catch Hook" URL. Events carry ids, amounts and states only.
ZAPIER_WEBHOOK_URL=
ZAPIER_TIMEOUT_MS=3000

# ─── Seed (yarn seed:demo) ─────────────────────────────────
# Password for every seeded demo account (at least 10 chars). Share it with judges in the Devpost notes.
SEED_DEMO_PASSWORD=
SEED_ADMIN_EMAIL=admin@enrichmint.demo
# Maria's PayPal SANDBOX personal account email (receives the demo payout).
SEED_MARIA_PAYOUT_EMAIL=

# ─── Jobs and demo tools ───────────────────────────────────
JOBS_ENABLED=true
# Admin-only "advance clock" for demo requests. Forced off in production.
DEMO_TOOLS_ENABLED=true
